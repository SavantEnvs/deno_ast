# libFuzzer dictionary of JS/TypeScript keywords, punctuation and operator tokens.
# Shared across all three deno_ast fuzz targets (parse_module, parse_program_tsx,
# parse_script) — they all lex/parse the same base ECMAScript+TypeScript token set, just with
# different grammar entry points (module/script/program) and media types (TS/TSX/JS).
# Each token MUST be single-line (a literal newline would split the entry across lines and
# make libFuzzer's dictionary parser abort at container-build time) — verified by round-
# tripping this file against a built binary (`<bin> -dict=... <corpus>`) before committing.
"function"
"return"
"class"
"extends"
"implements"
"interface"
"type"
"enum"
"namespace"
"declare"
"module"
"import"
"export"
"default"
"from"
"as"
"const"
"let"
"var"
"async"
"await"
"yield"
"static"
"get"
"set"
"new"
"this"
"super"
"typeof"
"instanceof"
"in"
"of"
"void"
"delete"
"throw"
"try"
"catch"
"finally"
"switch"
"case"
"break"
"continue"
"for"
"while"
"do"
"if"
"else"
"with"
"debugger"
"public"
"private"
"protected"
"readonly"
"abstract"
"is"
"asserts"
"satisfies"
"keyof"
"infer"
"unique"
"unknown"
"never"
"undefined"
"null"
"true"
"false"
"=>"
"..."
"??"
